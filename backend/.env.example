# Copy to backend/.env for local development. Placeholder values only:
# never commit a real key. Every setting uses the RAG_ prefix (app/config.py).

RAG_ENVIRONMENT=development

# --- LLM provider (Groq). Without a key the app runs, but generation returns 503.
RAG_LLM_PROVIDER=groq
RAG_GROQ_API_KEY=your_groq_api_key_here
# Model IDs must exist on your Groq account; check https://console.groq.com/docs/models
RAG_LIGHTWEIGHT_MODEL_ID=openai/gpt-oss-20b
RAG_COMPLEX_MODEL_ID=openai/gpt-oss-120b
# USD per 1,000 tokens. These are estimates you maintain; confirm current
# provider pricing before quoting any cost figure.
RAG_LIGHTWEIGHT_COST_INPUT_PER_1K=0.000075
RAG_LIGHTWEIGHT_COST_OUTPUT_PER_1K=0.00030
RAG_COMPLEX_COST_INPUT_PER_1K=0.00015
RAG_COMPLEX_COST_OUTPUT_PER_1K=0.00060
RAG_LIGHTWEIGHT_MAX_CONTEXT_TOKENS=8000
RAG_COMPLEX_MAX_CONTEXT_TOKENS=8000
RAG_LLM_MAX_COMPLETION_TOKENS=1024
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_MAX_RETRIES=1
RAG_LLM_FALLBACK_ENABLED=true

# --- Routing: complexity | fixed-lightweight | fixed-complex
RAG_ROUTING_POLICY=complexity
RAG_ROUTING_CONTEXT_TOKEN_THRESHOLD=2500
RAG_ROUTING_MULTI_DOC_THRESHOLD=2

# --- Embeddings: sentence-transformers (all-MiniLM-L6-v2, needs ~1 GB RAM with
# PyTorch) or simulated (lexical hashing, no model download, not semantic).
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_SIMULATED_EMBEDDING_DIM=256

# --- Semantic cache
RAG_SIMILARITY_THRESHOLD=0.82
RAG_CACHE_MAX_ENTRIES=1000
RAG_CACHE_MIN_EVIDENCE_OVERLAP=0.5

# --- Ingestion
RAG_MAX_UPLOAD_MB=10
RAG_MAX_PDF_PAGES=300
RAG_MAX_DOCUMENT_CHARS=2000000
RAG_CHUNK_SIZE_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150
RAG_MIN_CHUNK_CHARS=40

# --- Retrieval. Calibrate RAG_RETRIEVAL_MIN_RELEVANCE per embedding provider:
# 0.30 is the starting point for MiniLM; use about 0.15 with the hashing embedder.
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_MAX_TOP_K=12
RAG_RETRIEVAL_MIN_RELEVANCE=0.30

# --- Storage: one SQLite file for documents, vectors, cache and telemetry.
# In production point this at a persistent disk, e.g. /var/data/rag.db.
# RAG_DATABASE_PATH=/absolute/path/to/rag.db

# --- Security
# JSON list of allowed browser origins.
RAG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required for POST /api/metrics/reset when RAG_ENVIRONMENT=production.
RAG_ADMIN_TOKEN=
RAG_QUERY_RATE_LIMIT=30/minute
RAG_UPLOAD_RATE_LIMIT=10/minute
# false = store a hash instead of query text in telemetry.
RAG_TELEMETRY_STORE_QUERY_TEXT=true
