+function getSessionToken(): Promise<string> {
+  if (sessionToken) return Promise.resolve(sessionToken);
+  if (!sessionPromise) {
+    sessionPromise = startSession().finally(() => {
+      sessionPromise = null;
+    });
+  }
+  return sessionPromise;
